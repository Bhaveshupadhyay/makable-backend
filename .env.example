# Copy to .env and fill in. See README.md for setting up Supabase Auth with GitHub.

ENVIRONMENT=development
LOG_LEVEL=INFO

# The SPA's origin. In dev the API is served under it through the Vite proxy (same-origin cookies).
APP_URL=http://localhost:5173
# JSON list. Only needed if the SPA calls the API cross-origin.
CORS_ORIGINS=[]

# Postgres (e.g. Supabase's pooler). Use port 5432 for session mode, 6543 for transaction mode.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
# "require" encrypts without verifying the server. For production use verify-full with Supabase's CA certificate
# (dashboard -> Database -> SSL) and PGSSLROOTCERT=<path to it>.
DB_SSL=require
# Set to true for transaction-mode poolers (Supabase port 6543, PgBouncer).
DB_TRANSACTION_POOLER=false
# Per process. Total connections = workers x (pool size + overflow); keep it under the pooler's limit.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_COMMAND_TIMEOUT=60
# Or a full URL instead of the DB_* parts (it wins if set), e.g. SQLite for offline dev:
# DATABASE_URL=sqlite+aiosqlite:///./makable.db

# At least 32 characters: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Supabase dashboard -> Project Settings -> API. The publishable key (or legacy anon key), not the secret one.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# How long the browser keeps the refresh token cookie.
REFRESH_TOKEN_TTL_DAYS=30

# "Edit with AI": any OpenAI-compatible chat completions API. The default is a local OmniRoute
# (OMNIROUTE_SERVER_HOST=127.0.0.1 omniroute serve), which needs no key.
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_MODEL=auto
AI_TIMEOUT_SECONDS=90
# Adds the model input to AI edit responses (visible in the browser's network tab). Never in production.
AI_DEBUG=false
